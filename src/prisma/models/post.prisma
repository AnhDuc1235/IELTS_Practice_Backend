model Post {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String   @db.LongText
  thumbnail String
  thumbnailPublicId String
  images    postImage[]

  deletedAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamp()
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp()

  @@map("posts")
}
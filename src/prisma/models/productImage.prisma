model productImage {
  id                String  @id @default(uuid())
  url               String
  productId         String
  publicId          String
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamp()
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp()

  @@map("productImage")
}

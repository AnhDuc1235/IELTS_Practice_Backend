model postImage {
  id        String  @id @default(uuid())
  url       String
  postId    String
  publicId  String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamp()
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp()

  @@map("postImage")
}
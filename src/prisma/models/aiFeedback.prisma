model AiFeedback {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  attemptAnswerId BigInt   @map("attempt_answer_id") @db.UnsignedBigInt
  overallBand     Decimal? @map("overall_band") @db.Decimal(2, 1)
  criteriaScores  Json?    @map("criteria_scores")
  feedback        Json?
  modelName       String?  @map("model_name") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)

  attemptAnswer AttemptAnswer @relation(fields: [attemptAnswerId], references: [id], onDelete: Cascade)

  @@index([attemptAnswerId])
  @@map("ai_feedbacks")
}
